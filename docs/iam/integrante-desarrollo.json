{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PilaNash",
      "Effect": "Allow",
      "Action": ["cloudformation:*"],
      "Resource": [
        "arn:aws:cloudformation:*:*:stack/nash/*",
        "arn:aws:cloudformation:*:*:stack/aws-sam-cli-managed-default/*",
        "arn:aws:cloudformation:*:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "LeerPlantillas",
      "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:ListStacks", "cloudformation:GetTemplateSummary"],
      "Resource": "*"
    },
    {
      "Sid": "BucketsNash",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::nash-*", "arn:aws:s3:::nash-*/*",
        "arn:aws:s3:::aws-sam-cli-managed-default-*", "arn:aws:s3:::aws-sam-cli-managed-default-*/*"
      ]
    },
    {
      "Sid": "ServiciosDeLaApp",
      "Effect": "Allow",
      "Action": ["lambda:*", "apigateway:*", "cognito-idp:*", "glue:*", "athena:*"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-1" } }
    },
    {
      "Sid": "RolesNash",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:UntagRole",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/nash-*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents", "logs:StartQuery", "logs:GetQueryResults", "logs:CreateLogGroup", "logs:PutRetentionPolicy", "logs:DeleteLogGroup"],
      "Resource": "*"
    }
  ]
}
