{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AthenaGrupoNash",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:StopQueryExecution",
        "athena:ListQueryExecutions", "athena:GetWorkGroup", "athena:BatchGetQueryExecution",
        "athena:CreateNamedQuery", "athena:GetNamedQuery", "athena:ListNamedQueries"
      ],
      "Resource": "arn:aws:athena:*:*:workgroup/nash"
    },
    {
      "Sid": "VerGruposDeTrabajo",
      "Effect": "Allow",
      "Action": ["athena:ListWorkGroups", "athena:ListDataCatalogs", "athena:ListEngineVersions"],
      "Resource": "*"
    },
    {
      "Sid": "LeerCatalogo",
      "Effect": "Allow",
      "Action": ["glue:GetDatabase", "glue:GetDatabases", "glue:GetTable", "glue:GetTables", "glue:GetPartition", "glue:GetPartitions",
                 "glue:GetCrawler", "glue:GetCrawlers", "glue:GetJob", "glue:GetJobRun", "glue:GetJobRuns"],
      "Resource": "*"
    },
    {
      "Sid": "CorrerCrawlersYJob",
      "Effect": "Allow",
      "Action": ["glue:StartCrawler", "glue:StartJobRun"],
      "Resource": ["arn:aws:glue:*:*:crawler/nash-*", "arn:aws:glue:*:*:job/nash-*"]
    },
    {
      "Sid": "LeerElLago",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::nash-datos-*", "arn:aws:s3:::nash-datos-*/*"]
    },
    {
      "Sid": "ResultadosDeAthena",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::nash-datos-*/athena-resultados/*"
    },
    {
      "Sid": "PublicarElSitio",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::nash-web-*", "arn:aws:s3:::nash-web-*/*"]
    }
  ]
}
